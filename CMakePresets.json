{
    "version": 6,
    "configurePresets": [
        {
            "name": "vs",
            "displayName": "Visual Studio 2026 x64",
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "binaryDir": "${sourceDir}/build"
        }
    ],
    "buildPresets": [
        { "name": "dev", "configurePreset": "vs", "configuration": "RelWithDebInfo" },
        { "name": "debug", "configurePreset": "vs", "configuration": "Debug" },
        { "name": "release", "configurePreset": "vs", "configuration": "Release" }
    ],
    "testPresets": [
        {
            "name": "dev",
            "configurePreset": "vs",
            "configuration": "RelWithDebInfo",
            "output": { "outputOnFailure": true }
        }
    ]
}
